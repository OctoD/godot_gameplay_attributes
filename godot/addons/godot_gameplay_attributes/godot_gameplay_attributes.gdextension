[configuration]
entry_symbol = "gdextension_init"
compatibility_minimum = 4.4
reloadable = true

[libraries]
windows.debug.x86_64 = "bin/windows/godot_gameplay_attributes.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/windows/godot_gameplay_attributes.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "bin/linux/godot_gameplay_attributes.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/linux/godot_gameplay_attributes.linux.template_release.x86_64.so"
linux.debug.arm64 = "bin/linux/godot_gameplay_attributes.linux.template_debug.arm64.so"
linux.release.arm64 = "bin/linux/godot_gameplay_attributes.linux.template_release.arm64.so"
linux.debug.rv64 = "bin/linux/godot_gameplay_attributes.linux.template_debug.rv64.so"
linux.release.rv64 = "bin/linux/godot_gameplay_attributes.linux.template_release.rv64.so"
macos.debug.arm64 = "bin/macos/godot_gameplay_attributes.macos.template_debug.arm64.dylib"
macos.release.arm64 = "bin/macos/godot_gameplay_attributes.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "bin/macos/godot_gameplay_attributes.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "bin/macos/godot_gameplay_attributes.macos.template_release.x86_64.dylib"
